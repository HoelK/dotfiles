{
    "height":		50,
    "spacing":		10,
    "margin-top":	10,
    "margin-left":	10,
    "margin-right":	10,

    "modules-left":
    [
	    "hyprland/workspaces"
    ],
    "modules-center":
    [
	    "clock"
    ],
    "modules-right":
    [
        "pulseaudio",
		"backlight",
        "network",
        "battery"
    ],

    "hyprland/workspaces":
    {
	    "format":		"{icon}",
	    "format-icons":
	    {
		    "active":	"",
		    "default":	""
	    },
	    "persistent-workspaces":
	    {
		    "1":"",
		    "2":"",
		    "3":""
	    }
    },

    "clock": { "tooltip": false },

    "network":
    {
		"tooltip-format":		"{essid}",
        "format-wifi":			"",
        "format-ethernet":		"󰈁",
        "format-disconnected":	"󰖪"
    },

    "pulseaudio":
    {
		"tooltip":			false,
        "format":			"{volume}% {icon}",
        "format-muted":		" {format_source}",
        "format-icons":
		{
            "headphone":	"",
            "default":		["", "", ""]
        }
    },

    "backlight":
    {
        "format":		"{percent}% {icon}",
        "format-icons":	["", "", "", "", ""]
    },
    "battery":
    {
        "states":
		{
            "good":		100,
	    	"warning":	30,
	    	"critical":	20
        },
        "format":		"{capacity}% {icon}",
        "format-icons":	["", "", "", "", ""]
    }
}
